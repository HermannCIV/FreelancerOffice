# Aucune valeur réelle dans ce fichier. Copier en .env sur l'hôte de déploiement
# uniquement, et renseigner via le gestionnaire de secrets de la plateforme
# d'hébergement plutôt qu'un fichier en clair si possible.

NODE_ENV=production

# --- API Perfex (option A, cf. docs/01-ARCHITECTURE.md) ---
# URL de base de l'API existante de gESTION BtoB. DOIT etre https://.
PERFEX_BASE_URL=
# Methode d'authentification reelle a confirmer (cle API en en-tete, Bearer, OAuth2).
PERFEX_API_AUTH_SCHEME=api-key-header
PERFEX_API_KEY=
PERFEX_API_KEY_HEADER_NAME=X-Api-Key

# --- OAuth Claude -> ce service (cf. docs/05-SECURITE.md) ---
# Verification JWT reelle via JWKS (bibliotheque jose) ; ces 3 valeurs sont obligatoires
# au demarrage en dehors de NODE_ENV=test.
OAUTH_ISSUER_URL=
OAUTH_AUDIENCE=reporting-btob
OAUTH_JWKS_URL=
# Nom de la revendication (claim) JWT portant le perimetre societe. Non standardise par
# une RFC (contrairement a iss/aud/exp/scope) : a confirmer contre le fournisseur
# d'autorisation reellement choisi.
OAUTH_TENANT_CLAIM=tenant_scope_id
OAUTH_SCOPE_CLAIM=scope

# --- Perimetre entreprise ---
# Identifiant de societe Perfex resolu pour le jeton de service (mono-societe par defaut).
TENANT_SCOPE_ID=

# --- Limites de charge (cf. docs/04-LIMITES-DE-CHARGE.md) ---
PAGE_SIZE_MAX=100
MAX_PAGES_PER_QUERY=20
MAX_RANGE_DAYS=31
MAX_CONCURRENCY=2
MIN_REQUEST_INTERVAL_MS=150
RATE_LIMIT_PER_TOKEN_PER_MIN=30
RATE_LIMIT_PER_IP_PER_MIN=60
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_MAX_RETRIES=2
MAX_RESPONSE_BYTES=5242880

# --- Divers ---
REPORT_TIMEZONE=Africa/Abidjan
REPORT_CURRENCY=XOF
LOG_LEVEL=info
